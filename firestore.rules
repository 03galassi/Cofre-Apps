rules_version = '2';

// Cada usuário só lê e grava os próprios cadastros,
// e somente o e-mail autorizado tem acesso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == '03galassi@gmail.com';
    }
  }
}
